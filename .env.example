# ==============================================================================
# ECOHACK – ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection
# Local Development: SQLite (default)
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL example):
# DATABASE_URL="postgresql://user:password@localhost:5432/ecohack?schema=public"

# Session & JWT Authentication
JWT_SECRET="ecohack-secure-jwt-secret-replace-with-random-32-chars-in-prod"

# Secure Admin Bootstrap Secret Token
# Used by `npm run bootstrap:admin` to create or elevate the first administrator safely
ADMIN_SECRET_KEY="ecohack-admin-secure-init-key-9988"

# AI Vision Provider Configuration
# Set to 'gemini' for live AI analysis, or 'mock' for labeled sample demonstration mode
AI_PROVIDER="gemini"
# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=""
# Vision model (e.g., gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
