# ==============================================================================
# ECOHACK – ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection
# Local Development: SQLite (default)
DATABASE_URL="file:./dev.db"

# Production Database (Neon PostgreSQL connection string):
# Neon pooled connection format (with pgBouncer):
# DATABASE_URL="postgresql://user:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Session & JWT Authentication
JWT_SECRET="ecohack-secure-jwt-secret-replace-with-random-32-chars-in-prod"

# Secure Admin Bootstrap Secret Token
# Used by `npm run bootstrap:admin` to create or elevate the first administrator safely
ADMIN_SECRET_KEY="ecohack-admin-secure-init-key-9988"

# AI Vision Provider Configuration
# Set to 'gemini' for live AI analysis, or 'mock' for labeled sample demonstration mode
AI_PROVIDER="gemini"
# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=""
# Vision model (e.g., gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.5-flash)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Application Base URL
# Local: http://localhost:3000
# Production: https://ecohack.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Storage for Challenge Evidence Photos
# 1. Vercel Blob (Recommended for Vercel - automatically injected if Blob store is linked)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# 2. Cloudinary (Alternative)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="your-upload-preset"

